<Window x:Class="LocalTypeAssist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Type Assist" Width="1120" Height="760"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Montserrat, Segoe UI">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,22,0" />
        </Style>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="Background" Value="#242424" />
            <Setter Property="BorderBrush" Value="#383838" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#303030" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0F0F0F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LightButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="Background" Value="#F4F4F4" />
            <Setter Property="BorderBrush" Value="#F4F4F4" />
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="CaretBrush" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7E7E7" />
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,6,0,6" />
        </Style>
    </Window.Resources>

    <Border Background="#F2F2F2" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="34">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="#151515" CornerRadius="10">
                        <TextBlock Text="I" Foreground="White" FontFamily="Montserrat, Segoe UI"
                                   FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LOCAL TYPE ASSIST" Foreground="#151515" FontFamily="Montserrat, Segoe UI"
                               FontWeight="SemiBold" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#E2E2E2" CornerRadius="8" Padding="7,3" Margin="10,0,0,0">
                        <TextBlock Text="V7.0.4" Foreground="#555555" FontFamily="Montserrat, Segoe UI"
                                   FontSize="9" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Button Content="—" Width="42" Height="32" Background="Transparent" Foreground="#333333"
                            BorderThickness="0" FontSize="18" Click="Minimize_Click" />
                    <Button Content="×" Width="42" Height="32" Background="Transparent" Foreground="#333333"
                            BorderThickness="0" FontSize="20" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="22,0,22,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#151515" CornerRadius="38" Padding="34">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="StatusLabel" Text="⚡  АКТИВНО" Foreground="#666666"
                                       FontFamily="Montserrat, Segoe UI" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="SummaryLabel" Text="Локальное&#10;автодополнение"
                                       Style="{StaticResource Heading}" Foreground="#F7F7F7" FontSize="38"
                                       LineHeight="43" TextWrapping="Wrap" Margin="0,16,0,0" />
                            <TextBlock Text="Работает в браузере, почте, заметках и чатах. Данные не покидают компьютер."
                                       Style="{StaticResource Body}" Foreground="#777777" FontSize="12.5"
                                       TextWrapping="Wrap" Margin="0,12,8,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,34,0,0">
                            <Grid>
                                <TextBlock Text="ПРОГРЕСС ОБУЧЕНИЯ" Foreground="#666666" FontFamily="Montserrat, Segoe UI"
                                           FontSize="10" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProgressText" Text="0 подтверждений" HorizontalAlignment="Right"
                                           Foreground="#D9D9D9" FontFamily="Montserrat, Segoe UI" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,18,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="0" Foreground="#666666" FontFamily="Montserrat, Segoe UI" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="50" Foreground="#666666" FontFamily="Montserrat, Segoe UI"
                                           FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="100" Foreground="#666666" FontFamily="Montserrat, Segoe UI"
                                           FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Height="66" Background="#2B2B2B" CornerRadius="21" ClipToBounds="False">
                                <Grid ClipToBounds="False">
                                    <Border x:Name="ProgressGlow" Width="82" HorizontalAlignment="Left"
                                            Background="#F6F6F6" CornerRadius="19" Margin="2">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.75" Color="White" />
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,26,0,0">
                            <TextBlock Text="КАК ЭТО ВЫГЛЯДИТ" Foreground="#666666" FontFamily="Montserrat, Segoe UI"
                                       FontSize="10" FontWeight="SemiBold" />
                            <Border Background="#202020" CornerRadius="20" Padding="18" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Вы печатаете" Foreground="#777777" FontFamily="Montserrat, Segoe UI" FontSize="11" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="прог" Foreground="#F5F5F5" FontFamily="Montserrat, Segoe UI"
                                                   FontSize="24" FontWeight="SemiBold" />
                                        <TextBlock Text="рамма" Foreground="#777777" FontFamily="Montserrat, Segoe UI"
                                                   FontSize="24" FontWeight="SemiBold" />
                                        <Border Background="#353535" CornerRadius="7" Padding="7,3" Margin="10,2,0,2">
                                            <TextBlock Text="SHIFT отдельно — отменить" Foreground="#B8B8B8" FontFamily="Montserrat, Segoe UI"
                                                       FontSize="8.5" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <Border Background="#F4F4F4" CornerRadius="13" Padding="13,10" Margin="0,14,0,0">
                                        <Grid>
                                            <TextBlock Text="программа" Foreground="#111111" FontFamily="Montserrat, Segoe UI"
                                                       FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="AUTO" HorizontalAlignment="Right" Foreground="#777777"
                                                       FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" />
                                        </Grid>
                                    </Border>
                                    <Border Background="#262626" CornerRadius="13" Padding="13,10" Margin="0,4,0,0">
                                        <TextBlock Text="программирование" Foreground="#D0D0D0" FontFamily="Montserrat, Segoe UI"
                                                   FontSize="14" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,24,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="ToggleButton" Content="Поставить на паузу" Style="{StaticResource LightButton}" Click="Toggle_Click" />
                                <Button Grid.Column="2" Content="Свернуть в трей" Style="{StaticResource DarkButton}" Click="Hide_Click" />
                            </Grid>
                            <TextBlock Text="Ctrl + Alt + Space — включить или поставить на паузу"
                                       Foreground="#666666" FontFamily="Montserrat, Segoe UI"
                                       FontSize="10.5" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#151515" CornerRadius="38" Padding="26,26,14,26">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                        </ScrollViewer.Resources>
                        <StackPanel Margin="6,0,18,4">
                            <TextBlock Text="Настройки" Style="{StaticResource Heading}" Foreground="#F6F6F6" FontSize="31" />
                            <TextBlock Text="Единый чёрно-белый интерфейс и локальная модель для каждого профиля."
                                       Style="{StaticResource Body}" Foreground="#777777" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="0,5,0,24" />

                            <TextBlock Text="ПРОФИЛЬ" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ProfileTextBox" Style="{StaticResource DarkTextBox}" />
                                <Button Grid.Column="2" Content="Открыть" Style="{StaticResource DarkButton}" Click="SwitchProfile_Click" />
                            </Grid>
                            <TextBlock x:Name="ProfileHint" Text="База: 0 своих слов" Style="{StaticResource FieldHint}" Margin="0,7,0,0" />

                            <Border Height="1" Background="#2C2C2C" Margin="0,22,0,22" />
                            <TextBlock Text="АВТОДОПОЛНЕНИЕ" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Поведение" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="BehaviorHintText" Text="Выберите режим: список, дополнение по пробелу, после паузы или только обучение."
                                               Style="{StaticResource FieldHint}" />
                                </StackPanel>
                                <ComboBox x:Name="CompletionModeCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Только выпадающий список" Tag="Soft" />
                                    <ComboBoxItem Content="Дополнять по пробелу" Tag="Space" />
                                    <ComboBoxItem Content="Автодополнять после паузы" Tag="Immediate" />
                                    <ComboBoxItem Content="Только обучение" Tag="Training" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Показывать с буквы" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="После 4, 5, 6 и большего числа букв поиск продолжается до конца слова."
                                               Style="{StaticResource FieldHint}" />
                                </StackPanel>
                                <ComboBox x:Name="MinPrefixCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" />
                                    <ComboBoxItem Content="4" /><ComboBoxItem Content="5" /><ComboBoxItem Content="6" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Количество вариантов" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="MaxSuggestionsCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="1" /><ComboBoxItem Content="3" /><ComboBoxItem Content="5" />
                                </ComboBox>
                            </Grid>

                            <Grid x:Name="AutoPrefixGrid" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Автовставка минимум с" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="AutoPrefixCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="2 букв" Tag="2" /><ComboBoxItem Content="3 букв" Tag="3" />
                                    <ComboBoxItem Content="4 букв" Tag="4" /><ComboBoxItem Content="5 букв" Tag="5" />
                                    <ComboBoxItem Content="6 букв" Tag="6" /><ComboBoxItem Content="8 букв" Tag="8" />
                                </ComboBox>
                            </Grid>

                            <Grid x:Name="DelayGrid" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Пауза перед автовставкой" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="DelayValueText" Text="600 мс" Style="{StaticResource FieldHint}" />
                                </StackPanel>
                                <Slider x:Name="DelaySlider" Grid.Column="1"
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="250" Maximum="2000" TickFrequency="50"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="DelaySlider_Changed"
                                        Margin="2,0,2,0"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <CheckBox x:Name="ShiftCancelCheckBox" Content="Отдельное нажатие Shift отменяет автовставку; сочетания Shift работают обычно"
                                      Style="{StaticResource DarkCheck}" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <CheckBox x:Name="ShortWordsCheckBox" Content="Разрешить расширять уже законченные короткие слова"
                                      Style="{StaticResource DarkCheck}" Checked="Setting_Changed" Unchecked="Setting_Changed" />

                            <Border Height="1" Background="#2C2C2C" Margin="0,22,0,22" />
                            <TextBlock Text="КОНТЕКСТ И ГРАММАТИКА" Style="{StaticResource SectionTitle}" />

                            <CheckBox x:Name="SemanticCheckBox" Content="Предлагать следующее слово по контексту до пяти слов"
                                      Style="{StaticResource DarkCheck}" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <CheckBox x:Name="MorphologyCheckBox" Content="Учитывать лицо, род, число, падеж, склонения и спряжения"
                                      Style="{StaticResource DarkCheck}" Checked="Setting_Changed" Unchecked="Setting_Changed" />

                            <Grid Margin="0,8,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Форма первого лица" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Используется только после «я»; в остальных контекстах первое лицо получает штраф."
                                               Style="{StaticResource FieldHint}" />
                                </StackPanel>
                                <ComboBox x:Name="GenderCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Определять автоматически" Tag="Auto" />
                                    <ComboBoxItem Content="Женский род" Tag="Feminine" />
                                    <ComboBoxItem Content="Мужской род" Tag="Masculine" />
                                    <ComboBoxItem Content="Средний род" Tag="Neuter" />
                                </ComboBox>
                            </Grid>

                            <Border x:Name="TrainingModeCard" Background="#F3F3F3" BorderBrush="#F3F3F3" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,6,0,10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="РЕЖИМ ОБУЧЕНИЯ" Foreground="#151515" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="Подсказки и вставки отключены. Слова подтверждаются с задержкой, исправления и удаления записываются отдельно, а чистые наблюдения получают повышенный вес в будущих контекстных предложениях."
                                               Foreground="#555555" FontFamily="Montserrat, Segoe UI" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#202020" BorderBrush="#303030" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,6,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MorphologyStatusText" Text="Морфология загружается локально…"
                                               Foreground="#A0A0A0" FontFamily="Montserrat, Segoe UI"
                                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Перезапустить" Style="{StaticResource DarkButton}"
                                            Padding="11,6" Margin="12,0,0,0" Click="RetryMorphology_Click" />
                                </Grid>
                            </Border>

                            <CheckBox x:Name="LearnTypedCheckBox" Content="Учиться на словах, префиксах и контексте до пяти слов"
                                      Style="{StaticResource DarkCheck}" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <CheckBox x:Name="PersonalMlCheckBox" Content="Использовать персональную ML-модель как приоритет при ранжировании"
                                      Style="{StaticResource DarkCheck}" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <CheckBox x:Name="AutoStartCheckBox" Content="Запускать вместе с Windows"
                                      Style="{StaticResource DarkCheck}" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />

                            <Border Height="1" Background="#2C2C2C" Margin="0,22,0,22" />
                            <TextBlock Text="ОБУЧЕНИЕ НА СВОИХ ТЕКСТАХ" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="TXT, MD, CSV, LOG и JSON обучают частоты, префиксы и контекстные переходы до пяти слов. Данные обучения получают приоритет над стартовым словарём."
                                       Style="{StaticResource FieldHint}" Margin="0,0,0,12" />
                            <Button Content="Обучить на моих файлах" Style="{StaticResource DarkButton}" Click="ImportCorpus_Click" />

                            <Border Background="#F2F2F2" BorderBrush="#F2F2F2" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ПЕРСОНАЛЬНАЯ МОДЕЛЬ" Foreground="#151515" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="MlStatusText" Text="ML-модель ещё не обучена."
                                                   Foreground="#555555" FontFamily="Montserrat, Segoe UI" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,12,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Библиотека" Style="{StaticResource DarkButton}" Padding="12,7"
                                            Click="OpenLearningLibrary_Click" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Content="Папка данных" Style="{StaticResource DarkButton}" Click="OpenDataFolder_Click" />
                                <Button Grid.Column="2" Content="Сбросить профиль" Style="{StaticResource DarkButton}" Click="ResetProfile_Click" />
                            </Grid>

                            <Border Background="#202020" BorderBrush="#303030" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,18,0,0">
                                <TextBlock x:Name="FooterStatus" Text="Готово" Foreground="#8D8D8D"
                                           FontFamily="Montserrat, Segoe UI" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
