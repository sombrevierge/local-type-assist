<Window x:Class="LocalTypeAssist.SuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Focusable="False" FontFamily="Montserrat, Segoe UI">
    <Border Background="#151515"
            BorderBrush="#303030"
            BorderThickness="1"
            CornerRadius="24"
            Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.34" />
        </Border.Effect>

        <StackPanel>
            <Grid Margin="12,7,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="ПРЕДЛОЖЕНИЯ"
                               Foreground="#747474"
                               FontSize="10.5"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ContextHint"
                               Text="продолжение слова"
                               Foreground="#B5B5B5"
                               FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#242424" BorderBrush="#343434" BorderThickness="1"
                            CornerRadius="8" Padding="7,4" Margin="0,0,6,0">
                        <TextBlock Text="↑↓" Foreground="#BEBEBE" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#242424" BorderBrush="#343434" BorderThickness="1"
                            CornerRadius="8" Padding="7,4">
                        <TextBlock Text="TAB" Foreground="#BEBEBE" FontSize="9.5" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="SuggestionPanel" />

            <Grid Margin="12,11,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterHintText" Text="Выбранный вариант вставится после паузы"
                           Foreground="#666666"
                           FontSize="9.5"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F1F1" CornerRadius="7" Padding="7,3" Margin="0,0,6,0">
                        <TextBlock x:Name="FooterKeyText" Text="SHIFT отдельно" Foreground="#151515" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <TextBlock x:Name="FooterActionText" Text="отменить" Foreground="#888888" FontSize="9.5" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
