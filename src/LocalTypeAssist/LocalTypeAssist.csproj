<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LocalTypeAssist</AssemblyName>
    <RootNamespace>LocalTypeAssist</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <Version>6.8.0</Version>
    <FileVersion>6.8.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\seed_words.txt" />
    <EmbeddedResource Include="Resources\seed_phrases.tsv" />
    <PackageReference Include="Nestor" Version="0.5.2" />
  </ItemGroup>
</Project>
