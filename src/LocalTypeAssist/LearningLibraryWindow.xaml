<Window x:Class="LocalTypeAssist.LearningLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека обучения — Local Type Assist"
        Width="1080" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#111111"
        Foreground="#F3F3F3" FontFamily="Montserrat, Segoe UI">
    <Window.Resources>
        <Style x:Key="LibButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#232323" />
            <Setter Property="BorderBrush" Value="#393939" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="LibTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="CaretBrush" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#151515" />
            <Setter Property="Foreground" Value="#EDEDED" />
            <Setter Property="BorderBrush" Value="#303030" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#262626" />
            <Setter Property="RowBackground" Value="#151515" />
            <Setter Property="AlternatingRowBackground" Value="#191919" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="Foreground" Value="#A9A9A9" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="#EDEDED" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F2F2F2" />
                    <Setter Property="Foreground" Value="#111111" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#EDEDED" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F2F2F2" />
                    <Setter Property="Foreground" Value="#111111" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Библиотека обучения" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" Text="Загрузка данных…" Foreground="#777777" FontSize="11.5" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Обновить" Style="{StaticResource LibButton}" Click="Refresh_Click" Margin="0" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Background="#181818" BorderBrush="#303030" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,18,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource LibTextBox}" TextChanged="SearchBox_TextChanged" />
                <CheckBox x:Name="LikelyErrorsOnlyCheckBox" Grid.Column="1" Content="Требуют проверки"
                          Foreground="#D8D8D8" Margin="16,0,0,0" VerticalAlignment="Center"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <TextBlock Grid.Column="2" x:Name="FilterHintText" Foreground="#777777" VerticalAlignment="Center" Margin="18,0,0,0" />
                <Button Grid.Column="3" Content="Очистить вероятные ошибки" Style="{StaticResource LibButton}"
                        Margin="12,0,0,0" Click="PurgeLikelyErrors_Click" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="#111111" BorderBrush="#303030">
            <TabItem Header="СЛОВА">
                <Grid Margin="0,12,0,0">
                    <DataGrid x:Name="WordsGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Слово" Binding="{Binding Word}" Width="2*" />
                            <DataGridTextColumn Header="Набрано" Binding="{Binding TypedCount}" Width="80" />
                            <DataGridTextColumn Header="Подтверждено" Binding="{Binding ConfirmedCount}" Width="105" />
                            <DataGridTextColumn Header="Отказов" Binding="{Binding RejectedSuggestionCount}" Width="75" />
                            <DataGridTextColumn Header="Обучение" Binding="{Binding TrainingCount}" Width="85" />
                            <DataGridTextColumn Header="Исправлено от" Binding="{Binding CorrectedAwayCount}" Width="105" />
                            <DataGridTextColumn Header="Исправлено в" Binding="{Binding CorrectionTargetCount}" Width="100" />
                            <DataGridTextColumn Header="Удалено" Binding="{Binding DeletedCount}" Width="75" />
                            <DataGridCheckBoxColumn Header="Доверять" Binding="{Binding Trusted, Mode=OneWay}" IsReadOnly="True" Width="70" />
                            <DataGridCheckBoxColumn Header="Блок" Binding="{Binding Blocked, Mode=OneWay}" IsReadOnly="True" Width="60" />
                            <DataGridCheckBoxColumn Header="Проверить?" Binding="{Binding NeedsReview, Mode=OneWay}" IsReadOnly="True" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="ИСПРАВЛЕНИЯ">
                <Grid Margin="0,12,0,0">
                    <DataGrid x:Name="CorrectionsGrid" AutoGenerateColumns="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Было" Binding="{Binding Original}" Width="2*" />
                            <DataGridTextColumn Header="Стало" Binding="{Binding Corrected}" Width="2*" />
                            <DataGridTextColumn Header="Сколько раз" Binding="{Binding Count}" Width="110" />
                            <DataGridTextColumn Header="Последнее исправление" Binding="{Binding LastSeenUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Удалить выбранные" Style="{StaticResource LibButton}" Click="DeleteSelected_Click" />
            <Button Grid.Column="1" Content="Доверять / снять доверие" Style="{StaticResource LibButton}" Click="ToggleTrusted_Click" />
            <Button Grid.Column="2" Content="Блокировать / разблокировать" Style="{StaticResource LibButton}" Click="ToggleBlocked_Click" />
            <StackPanel Grid.Column="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="MlStatusText" Foreground="#A5A5A5" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="ML обучается только на локальных событиях и влияет на ранжирование, а не переписывает введённый текст."
                           Foreground="#666666" FontSize="9.5" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="TrainMlButton" Grid.Column="4" Content="Переобучить ML" Style="{StaticResource LibButton}" Margin="0" Click="TrainMl_Click" />
        </Grid>
    </Grid>
</Window>
